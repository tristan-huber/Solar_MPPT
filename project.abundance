      "uniqueID": "id-135413",
      "name": "util.Mirror",
      "topLevel": false,
      "allAtoms": [
        {
          "atomType": "Output",
          "x": 1,
          "y": 0.5,
          "uniqueID": "id-135410",
          "ioValues": [
            {
              "name": "number or geometry",
